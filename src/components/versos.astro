---
const versos=["quieroPoema.svg","floresVerano.svg","saborTernura.svg"];
---


<div id="versos" class="w-full h-screen mt-0 lg:bg-white bg-black">
    <div class="w-full lg:px-10 py-5 px-2">
        <h2 class="lg:text-4xl text-2xl font-zilla lg:text-black text-white 2xl:text-7xl">Versos</h2>
    </div>
    <div id="carrusel" class="w-full bg-black h-4/5 flex  justify-center items-center gap-3 transition-transform duration-500 delay-700">
        <button id="boton-izq" class="w-8 cursor-pointer"><img src="/imgpage/botton-izq.svg" alt="verso1" class="w-full object-contain"></button> 
        {
            versos.map((img)=>{

                if(img==="quieroPoema.svg"){
                    return <img src={`/imgpage/${img}`} alt="verso1" class="w-full lg:w-2/3 h-full object-fill lg:object-cover carrusel-img transition-transform duration-150 delay-300"> 
                }
                else{
                    return <img src={`/imgpage/${img}`} alt="verso1" class="w-full lg:w-2/3 h-full object-fill lg:object-cover carrusel-img transition-transform duration-150 delay-300 hidden">
                    
                }
            })
        }
         <button id="boton-der" class="w-8 cursor-pointer"><img src="/imgpage/botton-der.svg" alt="verso1" class="w-full object-contan"></button>
    </div>
    

</div>

<script src="../script/carrusel.js"></script>